# ==============================================================================
# QUICKNODE CONFIGURATION (PRIMARY DATA SOURCE)
# ==============================================================================

# QuickNode RPC Endpoint (получите на quicknode.com)
# Для Solana: https://your-endpoint.solana-mainnet.quiknode.pro/your-token/
# Для EVM: https://your-endpoint.ethereum.quiknode.pro/your-token/
QUICKNODE_RPC_URL=

# QuickNode WebSocket URL (опционально, для стриминга)
QUICKNODE_WS_URL=

# QuickNode API Key (если требуется)
QUICKNODE_API_KEY=

# QuickNode Performance Settings
QUICKNODE_BATCH_SIZE=100
POOL_REFRESH_INTERVAL_HOURS=6
VOLUME_MONITORING_INTERVAL_MIN=1
MAX_MONITORED_POOLS=5000

# Solana Settings
SOLANA_RAYDIUM_PROGRAM_ID=675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8

# QuickNode Enhanced APIs (optional)
USE_QUICKNODE_ENHANCED_APIS=false
QUICKNODE_DEX_METRICS_ENABLED=false

# ==============================================================================
# TELEGRAM NOTIFICATIONS
# ==============================================================================
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_PARSE_MODE=Markdown

# ==============================================================================
# LEGACY: GECKOTERMINAL MEGAFILTER (для обратной совместимости)
# ==============================================================================
GT_MEGAFILTER_BASE=https://pro-api.coingecko.com/api/v3/onchain
GT_MEGAFILTER_API_KEY=
GT_MEGAFILTER_CALLS_PER_MIN=30
GT_MEGAFILTER_PAGE_SIZE=100
GT_MEGAFILTER_SORT=h6_trending

# ==============================================================================
# FILTERS
# ==============================================================================
FDV_MIN=50000
FDV_MAX=800000
LIQUIDITY_MIN=50000
LIQUIDITY_MAX=800000
TX24H_MAX=2000
CHAINS=base,ethereum,solana
REVIVAL_MIN_AGE_DAYS=7

# ==============================================================================
# LOOP SETTINGS
# ==============================================================================
COOLDOWN_MIN=30
LOOP_SECONDS=60
CHAIN_SCAN_WORKERS=4
ALERT_FETCH_WORKERS=8
MAX_CYCLES=0

# ==============================================================================
# ALERTING
# ==============================================================================
ALERT_RATIO_MIN=1.0
MIN_PREV24_USD=1000

# ==============================================================================
# CACHING
# ==============================================================================
SEEN_TTL_MIN=30

# ==============================================================================
# LOGGING
# ==============================================================================
SAVE_CANDIDATES=true
CANDIDATES_PATH=./candidates.jsonl

# ==============================================================================
# DATABASE
# ==============================================================================
DB_PATH=wake_state.sqlite
