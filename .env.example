# ========================================
# Wake-up Bot - 1-Minute Megafilter Cycles
# ========================================

# Telegram Configuration
TG_BOT_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_telegram_chat_id
TG_PARSE_MODE=Markdown

# ========================================
# GeckoTerminal Megafilter (единый источник данных)
# ========================================
# Pro API для discovery + monitoring через один запрос
GT_MEGAFILTER_BASE=https://pro-api.coingecko.com/api/v3/onchain
GT_MEGAFILTER_API_KEY=your_coingecko_pro_api_key
GT_MEGAFILTER_CALLS_PER_MIN=30
GT_MEGAFILTER_PAGE_SIZE=100
GT_MEGAFILTER_SORT=h6_trending

# ========================================
# Filters
# ========================================
# FDV (Fully Diluted Valuation) range in USD
FDV_MIN=50000
FDV_MAX=800000

# Liquidity range in USD
LIQUIDITY_MIN=50000
LIQUIDITY_MAX=800000

# Maximum 24h transactions
TX24H_MAX=2000

# Chains to monitor (comma-separated)
# Supported: base, ethereum, solana, bsc, polygon, arbitrum, optimism, avalanche
CHAINS=base,ethereum,solana

# Minimum pool age in days (7 days by default)
# Ensures pools are mature before alerting
REVIVAL_MIN_AGE_DAYS=7

# ========================================
# Loop and Concurrency
# ========================================
# Cooldown period between alerts for same pool (minutes)
COOLDOWN_MIN=30

# Main loop cycle duration (seconds) - 60s = 1 minute cycles
LOOP_SECONDS=60

# Number of parallel workers for chain scanning
CHAIN_SCAN_WORKERS=4

# Number of parallel workers for alert fetching
ALERT_FETCH_WORKERS=8

# Maximum number of cycles to run (0 = infinite)
MAX_CYCLES=0

# ========================================
# Alerting
# ========================================
# Minimum ratio for 1h volume vs 24h volume to trigger alert
ALERT_RATIO_MIN=1.0

# Minimum 24h volume in USD to consider for alerts
MIN_PREV24_USD=1000

# ========================================
# Seen Cache
# ========================================
# Time-to-live for seen cache in minutes
SEEN_TTL_MIN=30

# Time-to-live for seen cache in seconds (overrides SEEN_TTL_MIN if set)
# SEEN_TTL_SEC=1800

# ========================================
# Logging
# ========================================
# Save discovered candidates to JSONL file
SAVE_CANDIDATES=true
CANDIDATES_PATH=./candidates.jsonl

# ========================================
# Database
# ========================================
# SQLite database path for state persistence
DB_PATH=wake_state.sqlite
