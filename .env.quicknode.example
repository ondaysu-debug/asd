# ==============================================================================
# QUICKNODE CONFIGURATION - ИСПРАВЛЕННАЯ ВЕРСИЯ
# ==============================================================================

# ⚠️ ВАЖНО: QuickNode требует ОТДЕЛЬНЫЕ endpoints для каждой сети!
# Получите endpoints на https://www.quicknode.com/

# Solana Mainnet Endpoint (ОБЯЗАТЕЛЬНО для Raydium)
# Пример: https://prettiest-skilled-seed.solana-mainnet.quiknode.pro/abc123def456/
QUICKNODE_SOLANA_URL=

# Ethereum Mainnet Endpoint (для Uniswap)  
# Пример: https://prettiest-skilled-seed.eth.quiknode.pro/abc123def456/
QUICKNODE_ETHEREUM_URL=

# Base Mainnet Endpoint (для Base DEX)
# Пример: https://prettiest-skilled-seed.base-mainnet.quiknode.pro/abc123def456/
QUICKNODE_BASE_URL=

# BSC Mainnet Endpoint (для PancakeSwap)
# Пример: https://prettiest-skilled-seed.bsc.quiknode.pro/abc123def456/
QUICKNODE_BSC_URL=

# QuickNode API Key (ОПЦИОНАЛЬНО - для Marketplace APIs)
# Токен УЖЕ включен в URL выше, этот параметр только для Marketplace
QUICKNODE_API_KEY=

# QuickNode Plan - для адаптивного rate limiting
# Варианты: essential (3.8 req/s), growth (19.2 req/s), enterprise (100+ req/s)
# Essential: 10M requests/month ≈ 230 requests/min
# Growth: 50M requests/month ≈ 1150 requests/min
QUICKNODE_PLAN=essential

# ==============================================================================
# QUICKNODE PERFORMANCE SETTINGS
# ==============================================================================

# Batch размер (QuickNode поддерживает до 100 запросов в батче)
QUICKNODE_BATCH_SIZE=100

# Интервал полного обновления пулов (в часах)
POOL_REFRESH_INTERVAL_HOURS=6

# Максимум пулов для одновременного мониторинга
MAX_MONITORED_POOLS=5000

# Интервал мониторинга объемов (в минутах)
VOLUME_MONITORING_INTERVAL_MIN=1

# Solana Raydium Program ID
SOLANA_RAYDIUM_PROGRAM_ID=675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8

# QuickNode Marketplace APIs (опционально)
USE_MARKETPLACE_APIS=false
MARKETPLACE_API_NAMES=

# ==============================================================================
# TELEGRAM NOTIFICATIONS
# ==============================================================================
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_PARSE_MODE=Markdown

# ==============================================================================
# FILTERS
# ==============================================================================
FDV_MIN=50000
FDV_MAX=800000
LIQUIDITY_MIN=50000
LIQUIDITY_MAX=800000
TX24H_MAX=2000
CHAINS=solana,base,ethereum
REVIVAL_MIN_AGE_DAYS=7

# ==============================================================================
# LOOP SETTINGS
# ==============================================================================
COOLDOWN_MIN=30
LOOP_SECONDS=60
CHAIN_SCAN_WORKERS=4
ALERT_FETCH_WORKERS=8
MAX_CYCLES=0

# ==============================================================================
# ALERTING
# ==============================================================================
ALERT_RATIO_MIN=1.0
MIN_PREV24_USD=1000

# ==============================================================================
# CACHING
# ==============================================================================
SEEN_TTL_MIN=30

# ==============================================================================
# LOGGING
# ==============================================================================
SAVE_CANDIDATES=true
CANDIDATES_PATH=./candidates.jsonl

# ==============================================================================
# DATABASE
# ==============================================================================
DB_PATH=wake_state.sqlite

# ==============================================================================
# LEGACY (сохранено для обратной совместимости)
# ==============================================================================
GT_MEGAFILTER_BASE=https://pro-api.coingecko.com/api/v3/onchain
GT_MEGAFILTER_API_KEY=
GT_MEGAFILTER_CALLS_PER_MIN=30
GT_MEGAFILTER_PAGE_SIZE=100
GT_MEGAFILTER_SORT=h6_trending

# ==============================================================================
# РАСЧЕТ ЗАПРОСОВ ДЛЯ QUICKNODE ESSENTIAL
# ==============================================================================
#
# Essential план: 10M requests/month = ~230 requests/min = ~3.8 requests/sec
#
# НАША АРХИТЕКТУРА:
# - Обновление пулов (раз в 6 часов): 
#   * Solana getProgramAccounts: 1 запрос → 10k+ пулов
#   * EVM eth_getLogs: 1 запрос на сеть × 3 = 3 запроса
#   * Metadata enrichment: ~50 batch запросов (по 100 пулов)
#   * ИТОГО: ~54 запроса раз в 6 часов = 0.15 запросов/мин
#
# - Мониторинг объемов (каждую минуту):
#   * 5000 пулов / 100 (batch size) = 50 batch запросов
#   * ИТОГО: ~50 запросов/мин
#
# ОБЩИЙ РАСХОД: ~50 запросов/мин ✅ ВПИСЫВАЕМСЯ В ЛИМИТ 230/мин!
#
# ==============================================================================
